LOG_LEVEL=debug
AGENT_ENDPOINTS=http://localhost:3000

###
# Message Pickup
###

# Forwarding Strategy
# MESSAGE_PICKUP__FORWARDING_STRATEGY=QueueAndLiveModeDelivery

# Default
# MESSAGE_PICKUP__STORAGE__TYPE=credo

# DynamoDB (AWS)
# MESSAGE_PICKUP__STORAGE__TYPE=dynamodb
# MESSAGE_PICKUP__DYNAMODB__REGION=us-east-1
# MESSAGE_PICKUP__DYNAMODB__ACCESS_KEY_ID=your-aws-access-key-id
# MESSAGE_PICKUP__DYNAMODB__SECRET_ACCESS_KEY=your-aws-secret-access-key
# MESSAGE_PICKUP__DYNAMODB__TABLE_NAME=queued_messages

# CosmosDB (Azure)
# MESSAGE_PICKUP__STORAGE__TYPE=cosmosdb
# MESSAGE_PICKUP__COSMOSDB__ENDPOINT=https://your-cosmosdb-account.documents.azure.com:443/
# MESSAGE_PICKUP__COSMOSDB__KEY=your-cosmosdb-primary-key
# MESSAGE_PICKUP__COSMOSDB__DATABASE_NAME=didcomm-mediator
# MESSAGE_PICKUP__COSMOSDB__CONTAINER_NAME=queued_messages

# Postgres
# MESSAGE_PICKUP__STORAGE__TYPE=postgres
# MESSAGE_PICKUP__STORAGE__HOST=localhost:5432
# MESSAGE_PICKUP__STORAGE__USER=postgres
# MESSAGE_PICKUP__STORAGE__PASSWORD=postgres
# MESSAGE_PICKUP__STORAGE__DATABASE=pickup

###
# Cache
###

# Default (in-memory)
# CACHE__TYPE=in-memory

# Redis
CACHE__TYPE=redis
CACHE__REDIS_URL=redis://127.0.0.1:6379

###
# Askar
###

ASKAR__STORE_ID=mediator-dev
ASKAR__STORE_KEY=mediator-dev
ASKAR__DATABASE__TYPE=sqlite # or postgres
# ASKAR__DATABASE__USER=postgres
# ASKAR__DATABASE__PASSWORD=postgres
# ASKAR__DATABASE__HOST=localhost:5432
# ASKAR__DATABASE__ADMIN_USER=postgres
# ASKAR__DATABASE__ADMIN_PASSWORD=postgres

###
# Drizzle
###

# STORAGE__DIALECT=sqlite # or postgres
# STORAGE__DATABASE_URL="file:./apps/mediator/database.db"

###
# Storage
###

# STORAGE__TYPE=drizzle # or askar

###
# KMS
###

# KMS__TYPE=askar (default, only option)

# PUSH_NOTIFICATIONS__WEBHOOK_URL=

# Firebase
PUSH_NOTIFICATIONS__FIREBASE__PROJECTS='[{"projectId":"test-app-id","clientEmail":"email@test.com","privateKey":"-----BEGIN PRIVATE KEY-----redacted-----END PRIVATE KEY-----\n"}]'
